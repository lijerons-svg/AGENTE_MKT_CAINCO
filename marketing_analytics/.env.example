# Copiar a .env (NUNCA commitear el .env real). Sin comillas en los valores.
META_SYSTEM_USER_TOKEN=
MAILCHIMP_API_KEY=
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# LinkedIn: Client ID/Secret salen de la pestaña "Autenticación" de la app en
# linkedin.com/developers. LINKEDIN_ACCESS_TOKEN (y LINKEDIN_REFRESH_TOKEN, si
# la app lo da) los completa solo el script de un solo uso
# `python -m marketing_analytics.connectors.linkedin.obtener_token` — no hace
# falta escribirlos a mano. El access token vence cada ~60 días.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
